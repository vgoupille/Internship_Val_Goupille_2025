      "source": [
        "# Démonstration de palettes supplémentaires avec seaborn (équivalent à diverses palettes R)\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Nettoyer les données\n",
        "penguins_clean_color = penguins.dropna(subset=[\"bill_length_mm\", \"bill_depth_mm\", \"species\"])\n",
        "\n",
        "# Création d'une figure avec plusieurs palettes de couleurs R-like\n",
        "f, axes = plt.subplots(3, 2, figsize=(14, 12))\n",
        "plt.subplots_adjust(hspace=0.4)\n",
        "\n",
        "# Liste des palettes à démontrer\n",
        "palettes = [\n",
        "    ('Set2', 'Similaire à RColorBrewer Set2'),\n",
        "    ('tab10', 'Similaire à R tableau10'),\n",
        "    ('crest', 'Similaire à viridisLite en R'),\n",
        "    ('mako', 'Similaire à viridisLite en R'),\n",
        "    ('rocket', 'Similaire à viridisLite en R'),\n",
        "    ('icefire', 'Similaire à colorcet en R')\n",
        "]\n",
        "\n",
        "# Créer un scatter plot pour chaque palette\n",
        "for (i, (palette, title)) in enumerate(palettes):\n",
        "    ax = axes[i//2, i%2]\n",
        "    \n",
        "    # Utiliser la palette pour le graphique\n",
        "    sns.scatterplot(\n",
        "        data=penguins_clean_color, \n",
        "        x=\"bill_length_mm\", \n",
        "        y=\"bill_depth_mm\",\n",
        "        hue=\"species\", \n",
        "        palette=palette,\n",
        "        s=80, \n",
        "        alpha=0.7,\n",
        "        ax=ax\n",
        "    )\n",
        "    \n",
        "    # Configurer le graphique\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Longueur du bec (mm)\")\n",
        "    ax.set_ylabel(\"Profondeur du bec (mm)\")\n",
        "    ax.legend(title=\"Espèce\")\n",
        "\n",
        "f.suptitle(\"Palettes de couleurs inspirées de packages R\", fontsize=16, y=0.98)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "3fcd5819",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
