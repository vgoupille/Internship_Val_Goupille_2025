      },
      "source": [
        "# Visualisations Interactives d'Expression Différentielle avec Plotly\n",
        "try:\n",
        "    import plotly.graph_objects as go\n",
        "    import plotly.express as px\n",
        "    from plotly.subplots import make_subplots\n",
        "    import plotly.figure_factory as ff\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install plotly\n",
        "    import plotly.graph_objects as go\n",
        "    import plotly.express as px\n",
        "    from plotly.subplots import make_subplots\n",
        "    import plotly.figure_factory as ff\n",
        "\n",
        "# Utiliser les données d'expression différentielle du chunk précédent\n",
        "\n",
        "# 1. Volcano Plot Interactif\n",
        "fig_volcano = px.scatter(\n",
        "    results.reset_index(), \n",
        "    x='log2FoldChange', \n",
        "    y='-log10(padj)',\n",
        "    color='significant',\n",
        "    hover_name='index',  # Montre l'ID du gène au survol\n",
        "    hover_data=['baseMean', 'pvalue', 'padj'],\n",
        "    color_discrete_map={True: 'red', False: 'grey'},\n",
        "    opacity=0.7,\n",
        "    title=\"Volcano Plot Interactif\",\n",
        "    labels={\n",
        "        'log2FoldChange': 'log2 Fold Change', \n",
        "        '-log10(padj)': '-log10(p-value ajustée)',\n",
        "        'significant': 'Significatif'\n",
        "    }\n",
        ")\n",
        "\n",
        "# Ajouter des lignes de seuil\n",
        "fig_volcano.add_shape(\n",
        "    type='line', line=dict(dash='dash', color='blue'),\n",
        "    x0=-6, x1=6, y0=-np.log10(0.05), y1=-np.log10(0.05)  # Ligne horizontale pour p-value\n",
        ")\n",
        "fig_volcano.add_shape(\n",
        "    type='line', line=dict(dash='dash', color='blue'),\n",
        "    x0=1, x1=1, y0=0, y1=7  # Ligne verticale pour FC positif\n",
        ")\n",
        "fig_volcano.add_shape(\n",
        "    type='line', line=dict(dash='dash', color='blue'),\n",
        "    x0=-1, x1=-1, y0=0, y1=7  # Ligne verticale pour FC négatif\n",
        ")\n",
        "\n",
        "# Améliorer la mise en page\n",
        "fig_volcano.update_layout(\n",
        "    legend_title_text='Significatif',\n",
        "    xaxis_range=[-6, 6],\n",
        "    yaxis_range=[0, 7]\n",
        ")\n",
        "\n",
        "# Afficher le volcano plot\n",
        "fig_volcano.show()\n",
        "\n",
        "# 2. Heatmap Interactif avec Clustering Hiérarchique\n",
        "# Sélectionner les gènes pour la heatmap\n",
        "if results['significant'].sum() > 5:\n",
        "    heat_genes = results[results['significant']].sort_values(by='padj').index[:40]\n",
        "else:\n",
        "    heat_genes = results.sort_values(by='padj').index[:40]\n",
        "\n",
        "# Préparer les données pour la heatmap\n",
        "heat_data = expr_df.loc[heat_genes]\n",
        "heat_data_z = pd.DataFrame(\n",
        "    stats.zscore(heat_data.values, axis=1),\n",
        "    index=heat_data.index,\n",
        "    columns=heat_data.columns\n",
        ")\n",
        "\n",
        "# Créer la heatmap avec clustering\n",
        "try:\n",
        "    fig_heatmap = ff.create_dendrogram(\n",
        "        heat_data_z, orientation='left',\n",
        "        labels=heat_data_z.index\n",
        "    )\n",
        "\n",
        "    # Réorganiser les données selon le clustering\n",
        "    dendro_leaves = fig_heatmap['layout']['yaxis']['ticktext']\n",
        "    dendro_idx = fig_heatmap['layout']['yaxis']['tickvals']\n",
        "    heat_data_z_clustered = heat_data_z.loc[dendro_leaves]\n",
        "except:\n",
        "    # Gérer les erreurs potentielles de clustering\n",
        "    print(\"Impossible de créer le dendrogramme. Utilisation des données sans clustering.\")\n",
        "    heat_data_z_clustered = heat_data_z\n",
        "\n",
        "# Créer la heatmap avec les données clustérisées ou non\n",
        "fig_heatmap = go.Figure(data=go.Heatmap(\n",
        "    z=heat_data_z_clustered.values,\n",
        "    x=heat_data_z_clustered.columns,\n",
        "    y=heat_data_z_clustered.index,\n",
        "    colorscale='RdBu_r',\n",
        "    zmid=0,\n",
        "    colorbar=dict(title='Z-score')\n",
        "))\n",
        "\n",
        "# Améliorer la mise en page\n",
        "fig_heatmap.update_layout(\n",
        "    title='Heatmap des Gènes Différentiellement Exprimés',\n",
        "    xaxis_title='Échantillons',\n",
        "    yaxis_title='Gènes',\n",
        "    height=800,\n",
        "    width=800\n",
        ")\n",
        "\n",
        "# Afficher la heatmap\n",
        "fig_heatmap.show()\n",
        "\n",
        "# 3. PCA Plot Interactif\n",
        "pca_df_reset = pca_df.reset_index().rename(columns={'index': 'sample'})\n",
        "\n",
        "fig_pca = px.scatter(\n",
        "    pca_df_reset, x='PC1', y='PC2',\n",
        "    color='condition', symbol='condition', \n",
        "    hover_name='sample',\n",
        "    title='Analyse en Composantes Principales',\n",
        "    labels={\n",
        "        'PC1': f'PC1 ({pca.explained_variance_ratio_[0]:.1%} variance)',\n",
        "        'PC2': f'PC2 ({pca.explained_variance_ratio_[1]:.1%} variance)',\n",
        "        'condition': 'Condition'\n",
        "    },\n",
        "    color_discrete_map={'Control': 'blue', 'Treatment': 'red'},\n",
        "    size_max=15\n",
        ")\n",
        "\n",
        "# Améliorer la mise en page\n",
        "fig_pca.update_layout(\n",
        "    legend_title_text='Condition',\n",
        "    height=600,\n",
        "    width=800\n",
        ")\n",
        "\n",
        "# Afficher le graphique PCA\n",
        "fig_pca.show()"
      ],
