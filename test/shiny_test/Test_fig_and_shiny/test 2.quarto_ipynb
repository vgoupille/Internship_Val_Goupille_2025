      "source": [
        "# Count plot of penguins by sex and species\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "# Remove rows with missing sex information for this plot\n",
        "penguins_clean = penguins.dropna(subset=['sex'])\n",
        "sns.countplot(data=penguins_clean, x=\"species\", hue=\"sex\")\n",
        "plt.title(\"Number of Penguins by Species and Sex\")\n",
        "plt.xlabel(\"Species\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "993ed8bd",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 8,
        "fig-format": "svg"
      },
      "source": [
        "# Heatmap of correlation between numerical variables\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Select only numeric columns\n",
        "numeric_data = penguins.select_dtypes(include=[np.number])\n",
        "# Calculate correlation matrix\n",
        "corr_matrix = numeric_data.corr()\n",
        "\n",
        "plt.figure(figsize=(10, 8))\n",
        "sns.heatmap(corr_matrix, annot=True, cmap=\"coolwarm\", linewidths=0.5)\n",
        "plt.title(\"Correlation Heatmap of Penguin Measurements\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "78b76c89",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 8,
        "fig-format": "svg"
      },
      "source": [
        "# Interactive scatter plot using Plotly\n",
        "try:\n",
        "    import plotly.express as px\n",
        "    import plotly.io as pio\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install plotly\n",
        "    import plotly.express as px\n",
        "    import plotly.io as pio\n",
        "\n",
        "# Filter out NaN values before creating the plot\n",
        "penguins_clean = penguins.dropna(subset=[\"bill_length_mm\", \"bill_depth_mm\", \"body_mass_g\"])\n",
        "\n",
        "# Create an interactive scatter plot\n",
        "fig = px.scatter(penguins_clean, \n",
        "                x=\"bill_length_mm\", \n",
        "                y=\"bill_depth_mm\", \n",
        "                color=\"species\",\n",
        "                size=\"body_mass_g\", \n",
        "                hover_name=\"species\",\n",
        "                hover_data=[\"island\", \"sex\", \"flipper_length_mm\"],\n",
        "                title=\"Interactive Scatter Plot of Bill Dimensions\",\n",
        "                labels={\"bill_length_mm\": \"Bill Length (mm)\",\n",
        "                        \"bill_depth_mm\": \"Bill Depth (mm)\"},\n",
        "                size_max=15)\n",
        "\n",
        "# Add trendlines for each species\n",
        "fig.update_traces(marker=dict(line=dict(width=1, color='DarkSlateGrey')))\n",
        "fig.update_layout(legend_title_text='Species')\n",
        "\n",
        "# Display the plot\n",
        "fig.show()"
      ],
      "id": "85aa3b6d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 8,
        "fig-format": "svg"
      },
      "source": [
        "# 3D scatter plot with Plotly\n",
        "try:\n",
        "    import plotly.express as px\n",
        "except ImportError:\n",
        "    pass  # Already installed in previous chunk\n",
        "\n",
        "# Filter out NaN values before creating the plot\n",
        "penguins_clean_3d = penguins.dropna(subset=[\"bill_length_mm\", \"bill_depth_mm\", \"flipper_length_mm\", \"body_mass_g\"])\n",
        "\n",
        "# Create a 3D scatter plot\n",
        "fig_3d = px.scatter_3d(penguins_clean_3d, \n",
        "                      x=\"bill_length_mm\", \n",
        "                      y=\"bill_depth_mm\", \n",
        "                      z=\"flipper_length_mm\",\n",
        "                      color=\"species\",\n",
        "                      size=\"body_mass_g\",\n",
        "                      hover_name=\"species\",\n",
        "                      opacity=0.7,\n",
        "                      title=\"3D Visualization of Penguin Measurements\")\n",
        "\n",
        "# Improve layout\n",
        "fig_3d.update_layout(\n",
        "    scene = dict(\n",
        "        xaxis_title='Bill Length (mm)',\n",
        "        yaxis_title='Bill Depth (mm)',\n",
        "        zaxis_title='Flipper Length (mm)'\n",
        "    )\n",
        ")\n",
        "\n",
        "# Display the plot\n",
        "fig_3d.show()"
      ],
      "id": "f55d008d",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 8,
        "fig-format": "svg"
      },
      "source": [
        "# Interactive visualization with Bokeh\n",
        "try:\n",
        "    from bokeh.plotting import figure, show\n",
        "    from bokeh.io import output_notebook\n",
        "    from bokeh.transform import factor_cmap\n",
        "    from bokeh.models import ColumnDataSource, HoverTool\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install bokeh\n",
        "    from bokeh.plotting import figure, show\n",
        "    from bokeh.io import output_notebook\n",
        "    from bokeh.transform import factor_cmap\n",
        "    from bokeh.models import ColumnDataSource, HoverTool\n",
        "\n",
        "# Clean data\n",
        "penguins_bokeh = penguins.dropna(subset=[\"bill_length_mm\", \"flipper_length_mm\", \"species\"])\n",
        "\n",
        "# Prepare data\n",
        "source = ColumnDataSource(penguins_bokeh)\n",
        "\n",
        "# Set up color mapping\n",
        "species_list = penguins_bokeh['species'].unique().tolist()\n",
        "colors = [\"#1f77b4\", \"#ff7f0e\", \"#2ca02c\"]  # Different color for each species\n",
        "\n",
        "# Create figure\n",
        "p = figure(title=\"Interactive Bokeh Plot: Bill Length vs Flipper Length\",\n",
        "           x_axis_label=\"Bill Length (mm)\", \n",
        "           y_axis_label=\"Flipper Length (mm)\",\n",
        "           height=400, width=700)\n",
        "\n",
        "# Add scatter points with different colors by species\n",
        "scatter = p.scatter(x=\"bill_length_mm\", y=\"flipper_length_mm\", \n",
        "                    size=10, source=source,\n",
        "                    color=factor_cmap('species', palette=colors, factors=species_list),\n",
        "                    legend_field=\"species\")\n",
        "\n",
        "# Add hover functionality\n",
        "hover = HoverTool()\n",
        "hover.tooltips = [\n",
        "    (\"Species\", \"@species\"),\n",
        "    (\"Island\", \"@island\"),\n",
        "    (\"Bill Length\", \"@bill_length_mm mm\"),\n",
        "    (\"Flipper Length\", \"@flipper_length_mm mm\"),\n",
        "    (\"Body Mass\", \"@body_mass_g g\")\n",
        "]\n",
        "p.add_tools(hover)\n",
        "\n",
        "# Configure legend\n",
        "p.legend.location = \"top_left\"\n",
        "p.legend.click_policy = \"hide\"\n",
        "\n",
        "# Display the plot\n",
        "output_notebook()\n",
        "show(p)"
      ],
      "id": "a5a732da",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 8,
        "fig-format": "svg"
      },
      "source": [
        "# Interactive visualization with Altair\n",
        "try:\n",
        "    import altair as alt\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install altair\n",
        "    import altair as alt\n",
        "\n",
        "# Clean data\n",
        "penguins_altair = penguins.dropna(subset=[\"bill_length_mm\", \"bill_depth_mm\", \"species\", \"sex\"])\n",
        "\n",
        "# Set Altair to use a renderer compatible with Quarto/Jupyter\n",
        "alt.renderers.enable('default')\n",
        "\n",
        "# Create an interactive scatter plot with selection\n",
        "selection = alt.selection_interval(bind='scales')\n",
        "\n",
        "# Create the chart\n",
        "chart = alt.Chart(penguins_altair).mark_point(size=100).encode(\n",
        "    x=alt.X('bill_length_mm', title='Bill Length (mm)'),\n",
        "    y=alt.Y('bill_depth_mm', title='Bill Depth (mm)'),\n",
        "    color='species:N',\n",
        "    shape='sex:N',\n",
        "    tooltip=['species', 'island', 'bill_length_mm', 'bill_depth_mm', 'flipper_length_mm', 'body_mass_g', 'sex']\n",
        ").properties(\n",
        "    title='Bill Dimensions by Species and Sex',\n",
        "    width=600,\n",
        "    height=400\n",
        ").add_selection(\n",
        "    selection\n",
        ").interactive()\n",
        "\n",
        "# Show the chart\n",
        "chart"
      ],
      "id": "4a14d114",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 7,
        "fig-format": "svg"
      },
      "source": [
        "# Visualization using plotnine (Python equivalent of ggplot2)\n",
        "try:\n",
        "    from plotnine import *\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install plotnine\n",
        "    from plotnine import *\n",
        "\n",
        "# Clean data\n",
        "penguins_clean_p9 = penguins.dropna(subset=[\"bill_length_mm\", \"flipper_length_mm\", \"species\", \"sex\"])\n",
        "\n",
        "# Create a ggplot-like visualization\n",
        "plot = (ggplot(penguins_clean_p9, aes(x='flipper_length_mm', y='bill_length_mm', \n",
        "                                      color='species', shape='sex')) +\n",
        "        geom_point(size=3, alpha=0.7) +\n",
        "        stat_smooth(method='lm', se=True, alpha=0.2) +\n",
        "        labs(title='Bill Length vs Flipper Length by Species and Sex',\n",
        "             x='Flipper Length (mm)',\n",
        "             y='Bill Length (mm)') +\n",
        "        theme_minimal() +\n",
        "        facet_wrap('~ island') +  # Create separate panels by island\n",
        "        scale_color_brewer(type='qual', palette='Set1'))\n",
        "\n",
        "print(plot)"
      ],
      "id": "1f07f619",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
