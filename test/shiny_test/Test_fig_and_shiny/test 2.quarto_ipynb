      "source": [
        "# Matplotlib orienté objet avec style ggplot\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "from matplotlib.gridspec import GridSpec\n",
        "\n",
        "# Configurer le style\n",
        "plt.style.use('ggplot')\n",
        "\n",
        "# Nettoyer les données\n",
        "penguins_clean_mpl = penguins.dropna(subset=[\"bill_length_mm\", \"flipper_length_mm\", \"species\", \"island\"])\n",
        "\n",
        "# Obtenir les îles uniques\n",
        "islands = penguins_clean_mpl['island'].unique()\n",
        "\n",
        "# Créer la figure avec style ggplot\n",
        "fig = plt.figure(figsize=(12, 8))\n",
        "gs = GridSpec(2, 2, figure=fig)\n",
        "\n",
        "# Créer une palette de couleurs\n",
        "colors = {'Adelie': '#FF5733', 'Gentoo': '#33A1FF', 'Chinstrap': '#33FF57'}\n",
        "\n",
        "# Créer des sous-graphiques pour chaque île (similaire à facet_wrap)\n",
        "for i, island in enumerate(islands):\n",
        "    ax = fig.add_subplot(gs[i//2, i%2])\n",
        "    \n",
        "    # Filtrer les données\n",
        "    island_data = penguins_clean_mpl[penguins_clean_mpl['island'] == island]\n",
        "    \n",
        "    # Tracer les points pour chaque espèce\n",
        "    for species in island_data['species'].unique():\n",
        "        species_data = island_data[island_data['species'] == species]\n",
        "        ax.scatter(species_data['flipper_length_mm'], species_data['bill_length_mm'], \n",
        "                  label=species, alpha=0.7, s=70, color=colors[species])\n",
        "        \n",
        "        # Ajouter une ligne de régression (similaire à geom_smooth)\n",
        "        if len(species_data) > 2:  # Besoin d'au moins 2 points pour la régression\n",
        "            x = species_data['flipper_length_mm']\n",
        "            y = species_data['bill_length_mm']\n",
        "            z = np.polyfit(x, y, 1)\n",
        "            p = np.poly1d(z)\n",
        "            x_range = np.linspace(x.min(), x.max(), 100)\n",
        "            ax.plot(x_range, p(x_range), '--', color=colors[species], alpha=0.8)\n",
        "    \n",
        "    # Configurer le graphique\n",
        "    ax.set_xlabel('Longueur des ailerons (mm)')\n",
        "    ax.set_ylabel('Longueur du bec (mm)')\n",
        "    ax.set_title(f'Île: {island}')\n",
        "    \n",
        "    # Ajouter une légende uniquement au premier graphique\n",
        "    if i == 0:\n",
        "        ax.legend(title=\"Espèce\")\n",
        "\n",
        "fig.suptitle('Analyse des dimensions corporelles des pingouins par île', fontsize=16, y=0.98)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "662df9bb",
      "execution_count": null,
      "outputs": []
    },
