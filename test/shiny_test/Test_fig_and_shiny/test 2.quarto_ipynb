      "source": [
        "#do a plotr for the penguins dataset\n",
        "import pandas as pd\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Instead of downloading, let's install and use palmerpenguins package\n",
        "try:\n",
        "    from palmerpenguins import load_penguins\n",
        "    penguins = load_penguins()\n",
        "except ImportError:\n",
        "    # If palmerpenguins is not installed, install it\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install palmerpenguins\n",
        "    from palmerpenguins import load_penguins\n",
        "    penguins = load_penguins()\n",
        "\n",
        "# Display the first few rows of the dataset\n",
        "print(penguins.head())\n",
        "\n",
        "# Create a scatter plot of bill length vs bill depth, colored by species\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.scatterplot(data=penguins, x=\"bill_length_mm\", y=\"bill_depth_mm\", \n",
        "                hue=\"species\", style=\"species\", s=100)\n",
        "\n",
        "# Add title and labels\n",
        "plt.title(\"Bill Length vs Bill Depth by Penguin Species\")\n",
        "plt.xlabel(\"Bill Length (mm)\")\n",
        "plt.ylabel(\"Bill Depth (mm)\")\n",
        "\n",
        "# Show the plot\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "6fe51d12",
      "execution_count": null,
      "outputs": []
    },
