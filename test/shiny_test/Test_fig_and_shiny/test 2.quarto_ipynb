      "source": [
        "# Visualisation avec Plotly et palettes de couleurs personnalisées\n",
        "try:\n",
        "    import plotly.express as px\n",
        "    import plotly.graph_objects as go\n",
        "except ImportError:\n",
        "    pass  # Déjà installé dans les chunks précédents\n",
        "\n",
        "# Nettoyer les données\n",
        "penguins_clean_px = penguins.dropna(subset=[\"bill_length_mm\", \"flipper_length_mm\", \"species\", \"island\"])\n",
        "\n",
        "# Définition de palettes personnalisées inspirées de packages R\n",
        "custom_palettes = {\n",
        "    \"jco\": [\"#0073C2\", \"#EFC000\", \"#868686\", \"#CD534C\", \"#7AA6DC\"],  # Journal Clinical Oncology (ggsci)\n",
        "    \"nejm\": [\"#BC3C29\", \"#0072B5\", \"#E18727\", \"#20854E\", \"#7876B1\"],  # New England Journal of Medicine (ggsci)\n",
        "    \"lancet\": [\"#00468B\", \"#ED0000\", \"#42B540\", \"#0099B4\", \"#925E9F\"],  # Lancet (ggsci)\n",
        "    \"futurama\": [\"#FF6F00\", \"#C71000\", \"#008EA0\", \"#8A4198\", \"#5A9599\"],  # Inspiré de Futurama (généré par IA)\n",
        "    \"mondrian\": [\"#D0202E\", \"#3360A9\", \"#F3C91D\", \"#1A1A1A\", \"#D6D6D6\"]  # Inspiré de Piet Mondrian (généré par IA)\n",
        "}\n",
        "\n",
        "# Créer une figure avec sous-graphiques\n",
        "fig = go.Figure()\n",
        "\n",
        "# Ajouter un bouton pour chaque palette\n",
        "buttons = []\n",
        "\n",
        "for i, (palette_name, palette_colors) in enumerate(custom_palettes.items()):\n",
        "    # Ajouter des traces pour chaque espèce avec la palette actuelle\n",
        "    for j, species in enumerate(penguins_clean_px['species'].unique()):\n",
        "        species_data = penguins_clean_px[penguins_clean_px['species'] == species]\n",
        "        \n",
        "        # Utiliser modulo pour s'assurer que nous ne dépassons pas le nombre de couleurs disponibles\n",
        "        color_idx = j % len(palette_colors)\n",
        "        \n",
        "        fig.add_trace(\n",
        "            go.Scatter(\n",
        "                x=species_data['flipper_length_mm'],\n",
        "                y=species_data['bill_length_mm'],\n",
        "                mode='markers',\n",
        "                marker=dict(color=palette_colors[color_idx], size=12),\n",
        "                name=species,\n",
        "                text=species_data['island'],\n",
        "                hovertemplate=\"<b>%{text}</b><br>Espèce: \" + species + \n",
        "                              \"<br>Longueur des ailerons: %{x} mm<br>Longueur du bec: %{y} mm\",\n",
        "                visible=(i==0)  # Seule la première palette est visible par défaut\n",
        "            )\n",
        "        )\n",
        "    \n",
        "    # Créer un bouton pour cette palette\n",
        "    visible_list = [True if i==btn_idx else False for btn_idx in range(len(custom_palettes)) \n",
        "                    for _ in range(len(penguins_clean_px['species'].unique()))]\n",
        "    \n",
        "    buttons.append(dict(\n",
        "        label=palette_name,\n",
        "        method=\"update\",\n",
        "        args=[{\"visible\": visible_list},\n",
        "              {\"title\": f\"Palette: {palette_name} (inspirée de packages R)\"}]\n",
        "    ))\n",
        "\n",
        "# Ajouter le menu de sélection de palette\n",
        "fig.update_layout(\n",
        "    updatemenus=[{\n",
        "        \"buttons\": buttons,\n",
        "        \"direction\": \"down\",\n",
        "        \"showactive\": True,\n",
        "        \"x\": 0.1,\n",
        "        \"y\": 1.15,\n",
        "        \"xanchor\": \"left\",\n",
        "        \"yanchor\": \"top\"\n",
        "    }],\n",
        "    title=\"Palette: jco (inspirée de packages R)\",\n",
        "    xaxis_title=\"Longueur des ailerons (mm)\",\n",
        "    yaxis_title=\"Longueur du bec (mm)\",\n",
        "    height=600,\n",
        "    width=800,\n",
        "    annotations=[\n",
        "        dict(text=\"Choisir une palette:\", x=0, y=1.12, xref=\"paper\", yref=\"paper\",\n",
        "             showarrow=False, font=dict(size=14))\n",
        "    ]\n",
        ")\n",
        "\n",
        "fig.show()"
      ],
      "id": "e90bc038",
      "execution_count": null,
      "outputs": []
    },
