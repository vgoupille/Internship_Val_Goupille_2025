      "source": [
        "# Utilisation de palettes de couleurs similaires à R en Python\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "# Nettoyer les données\n",
        "penguins_clean_color = penguins.dropna(subset=[\"bill_length_mm\", \"body_mass_g\", \"species\"])\n",
        "\n",
        "# Créer une figure avec plusieurs sous-graphiques\n",
        "fig, axes = plt.subplots(2, 2, figsize=(12, 10))\n",
        "plt.subplots_adjust(hspace=0.4, wspace=0.3)\n",
        "\n",
        "# 1. Palette ColorBrewer (similaire à RColorBrewer)\n",
        "try:\n",
        "    from palettable.colorbrewer.qualitative import Set1_3, Dark2_3\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install palettable\n",
        "    from palettable.colorbrewer.qualitative import Set1_3, Dark2_3\n",
        "\n",
        "# Utilisation de la palette Set1 (très populaire dans R)\n",
        "ax = axes[0, 0]\n",
        "for i, species in enumerate(penguins_clean_color['species'].unique()):\n",
        "    subset = penguins_clean_color[penguins_clean_color['species'] == species]\n",
        "    ax.scatter(subset['bill_length_mm'], subset['body_mass_g'], \n",
        "               label=species, color=Set1_3.hex_colors[i], s=60, alpha=0.7)\n",
        "ax.set_title('Palette ColorBrewer \"Set1\"')\n",
        "ax.set_xlabel('Longueur du bec (mm)')\n",
        "ax.set_ylabel('Masse corporelle (g)')\n",
        "ax.legend()\n",
        "\n",
        "# 2. Palette viridis (populaire en R et disponible directement dans matplotlib)\n",
        "ax = axes[0, 1]\n",
        "# Création d'une catégorie numérique pour mapper les couleurs\n",
        "species_to_num = {sp: i for i, sp in enumerate(penguins_clean_color['species'].unique())}\n",
        "penguins_clean_color['species_num'] = penguins_clean_color['species'].map(species_to_num)\n",
        "\n",
        "scatter = ax.scatter(penguins_clean_color['bill_length_mm'], \n",
        "                    penguins_clean_color['body_mass_g'],\n",
        "                    c=penguins_clean_color['species_num'], \n",
        "                    cmap='viridis', \n",
        "                    s=60, alpha=0.7)\n",
        "\n",
        "# Légende manuelle pour viridis\n",
        "handles, labels = scatter.legend_elements(prop=\"colors\", alpha=0.7)\n",
        "legend = ax.legend(handles, penguins_clean_color['species'].unique(), loc=\"upper left\", title=\"Espèce\")\n",
        "ax.set_title('Palette \"viridis\"')\n",
        "ax.set_xlabel('Longueur du bec (mm)')\n",
        "ax.set_ylabel('Masse corporelle (g)')\n",
        "\n",
        "# 3. Palette Wes Anderson (similaire au package wesanderson en R)\n",
        "ax = axes[1, 0]\n",
        "try:\n",
        "    from palettable.wesanderson import Zissou_5\n",
        "except ImportError:\n",
        "    # Définir manuellement une palette inspirée de Wes Anderson si palettable n'a pas la palette\n",
        "    Zissou_5 = type('obj', (object,), {\n",
        "        'hex_colors': ['#3B9AB2', '#78B7C5', '#EBCC2A', '#E1AF00', '#F21A00']\n",
        "    })\n",
        "\n",
        "# Utilisation de la palette Zissou\n",
        "wes_colors = Zissou_5.hex_colors[:3]  # Prendre 3 couleurs pour les 3 espèces\n",
        "for i, species in enumerate(penguins_clean_color['species'].unique()):\n",
        "    subset = penguins_clean_color[penguins_clean_color['species'] == species]\n",
        "    ax.scatter(subset['bill_length_mm'], subset['body_mass_g'], \n",
        "               label=species, color=wes_colors[i], s=60, alpha=0.7)\n",
        "ax.set_title('Palette Wes Anderson \"Zissou\"')\n",
        "ax.set_xlabel('Longueur du bec (mm)')\n",
        "ax.set_ylabel('Masse corporelle (g)')\n",
        "ax.legend()\n",
        "\n",
        "# 4. Palette scientifique (similaire à ggsci en R)\n",
        "ax = axes[1, 1]\n",
        "try:\n",
        "    from palettable.scientific import sequential as sci_seq\n",
        "    sci_palette = sci_seq.Devon_20.hex_colors\n",
        "except ImportError:\n",
        "    # Palette scientifique alternative de seaborn\n",
        "    sci_palette = sns.color_palette(\"husl\", 3)\n",
        "    sci_palette = [sns.mpl.colors.rgb2hex(col) for col in sci_palette]\n",
        "\n",
        "# Utilisation de la palette scientifique\n",
        "for i, species in enumerate(penguins_clean_color['species'].unique()):\n",
        "    subset = penguins_clean_color[penguins_clean_color['species'] == species]\n",
        "    ax.scatter(subset['bill_length_mm'], subset['body_mass_g'], \n",
        "               label=species, color=sci_palette[i], s=60, alpha=0.7)\n",
        "ax.set_title('Palette scientifique \"Devon\"')\n",
        "ax.set_xlabel('Longueur du bec (mm)')\n",
        "ax.set_ylabel('Masse corporelle (g)')\n",
        "ax.legend()\n",
        "\n",
        "fig.suptitle('Comparaison de palettes de couleurs similaires à celles de R', \n",
        "             fontsize=16, y=0.98)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
