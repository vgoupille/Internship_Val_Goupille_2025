      "source": [
        "# Interactive visualization with HoloViews/hvPlot\n",
        "try:\n",
        "    import holoviews as hv\n",
        "    import hvplot.pandas\n",
        "except ImportError:\n",
        "    import sys\n",
        "    !{sys.executable} -m pip install holoviews hvplot\n",
        "    import holoviews as hv\n",
        "    import hvplot.pandas\n",
        "\n",
        "# Initialize HoloViews extension\n",
        "hv.extension('bokeh')\n",
        "\n",
        "# Clean data\n",
        "penguins_clean_hv = penguins.dropna(subset=[\"bill_length_mm\", \"body_mass_g\", \"species\"])\n",
        "\n",
        "# Create interactive scatter plot with hvPlot\n",
        "scatter_plot = penguins_clean_hv.hvplot.scatter(\n",
        "    x='bill_length_mm',\n",
        "    y='body_mass_g',\n",
        "    by='species',\n",
        "    hover_cols=['island', 'sex', 'flipper_length_mm'],\n",
        "    height=400,\n",
        "    width=700,\n",
        "    title='Bill Length vs Body Mass by Species',\n",
        "    xlabel='Bill Length (mm)',\n",
        "    ylabel='Body Mass (g)',\n",
        "    size=80,\n",
        "    legend='top',\n",
        "    grid=True\n",
        ")\n",
        "\n",
        "# Display the plot\n",
        "scatter_plot"
      ],
      "id": "14edb640",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 7,
        "fig-format": "svg"
      },
      "source": [
        "# Animated visualization with Matplotlib\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.animation as animation\n",
        "from matplotlib.animation import FuncAnimation\n",
        "import numpy as np\n",
        "\n",
        "# Clean data and prepare for animation\n",
        "penguins_anim = penguins.dropna(subset=[\"bill_length_mm\", \"bill_depth_mm\", \"species\"])\n",
        "species_list = penguins_anim['species'].unique()\n",
        "colors = {\"Adelie\": \"red\", \"Gentoo\": \"blue\", \"Chinstrap\": \"green\"}\n",
        "\n",
        "# Create figure and axes\n",
        "fig, ax = plt.subplots(figsize=(10, 6))\n",
        "\n",
        "# Initialize scatter plot\n",
        "scatter = ax.scatter([], [], c=[], s=100, alpha=0.7)\n",
        "ax.set_xlim(penguins_anim['bill_length_mm'].min() - 2, \n",
        "           penguins_anim['bill_length_mm'].max() + 2)\n",
        "ax.set_ylim(penguins_anim['bill_depth_mm'].min() - 1, \n",
        "           penguins_anim['bill_depth_mm'].max() + 1)\n",
        "ax.set_xlabel('Bill Length (mm)')\n",
        "ax.set_ylabel('Bill Depth (mm)')\n",
        "ax.set_title('Penguin Bill Dimensions by Species (Animated)')\n",
        "\n",
        "# Create legend elements\n",
        "legend_elements = [plt.Line2D([0], [0], marker='o', color='w', \n",
        "                             markerfacecolor=colors[s], markersize=10, label=s) \n",
        "                  for s in species_list]\n",
        "ax.legend(handles=legend_elements, loc='upper right')\n",
        "\n",
        "# Define update function for animation\n",
        "def update(frame):\n",
        "    # Filter data for the current species\n",
        "    species = species_list[frame % len(species_list)]\n",
        "    data = penguins_anim[penguins_anim['species'] == species]\n",
        "    \n",
        "    # Update data\n",
        "    scatter.set_offsets(np.column_stack((data['bill_length_mm'], data['bill_depth_mm'])))\n",
        "    scatter.set_color(colors[species])\n",
        "    \n",
        "    ax.set_title(f'Penguin Bill Dimensions: {species}')\n",
        "    return scatter,\n",
        "\n",
        "# Create animation\n",
        "ani = FuncAnimation(fig, update, frames=len(species_list), \n",
        "                   interval=1000, blit=True, repeat=True)\n",
        "\n",
        "# Save animation as GIF\n",
        "try:\n",
        "    from IPython.display import HTML\n",
        "    HTML(ani.to_jshtml())\n",
        "except:\n",
        "    plt.close()  # Close the animation figure if it fails\n",
        "\n",
        "# Show the plot with all species for static display\n",
        "plt.figure(figsize=(10, 6))\n",
        "for species in species_list:\n",
        "    data = penguins_anim[penguins_anim['species'] == species]\n",
        "    plt.scatter(data['bill_length_mm'], data['bill_depth_mm'], \n",
        "               label=species, color=colors[species], s=100, alpha=0.7)\n",
        "plt.xlabel('Bill Length (mm)')\n",
        "plt.ylabel('Bill Depth (mm)')\n",
        "plt.title('Penguin Bill Dimensions by Species (Static Version)')\n",
        "plt.legend()\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "31303ae8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "from plotnine import ggplot, geom_point, aes, stat_smooth, facet_wrap\n",
        "from plotnine.data import mtcars\n",
        "\n",
        "(\n",
        "    ggplot(mtcars, aes(\"wt\", \"mpg\", color=\"factor(gear)\"))\n",
        "    + geom_point()\n",
        "    + stat_smooth(method=\"lm\")\n",
        "    + facet_wrap(\"gear\")\n",
        ")"
      ],
      "id": "42b76bc8",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "cache": true,
        "fig-width": 10,
        "fig-height": 6,
        "fig-format": "svg"
      },
      "source": [
        "# Seaborn avec style ggplot et une approche plus déclarative\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Configurer le style pour ressembler à ggplot\n",
        "plt.style.use('ggplot')\n",
        "\n",
        "# Nettoyer les données\n",
        "penguins_clean_sns = penguins.dropna(subset=[\"bill_length_mm\", \"flipper_length_mm\", \"species\", \"sex\"])\n",
        "\n",
        "# Création d'un FacetGrid (similaire à facet_wrap de ggplot)\n",
        "g = sns.FacetGrid(penguins_clean_sns, col=\"island\", hue=\"species\", height=4, aspect=1.2)\n",
        "\n",
        "# Mapper des graphiques sur chaque facette\n",
        "g.map(sns.scatterplot, \"flipper_length_mm\", \"bill_length_mm\", alpha=0.7, s=80)\n",
        "\n",
        "# Ajouter une ligne de régression\n",
        "g.map(sns.regplot, \"flipper_length_mm\", \"bill_length_mm\", scatter=False, ci=95)\n",
        "\n",
        "# Améliorer l'esthétique\n",
        "g.add_legend(title=\"Espèce\")\n",
        "g.set_axis_labels(\"Longueur des ailerons (mm)\", \"Longueur du bec (mm)\")\n",
        "g.set_titles(\"Île: {col_name}\")\n",
        "g.fig.suptitle(\"Relation entre longueur du bec et des ailerons par île\", y=1.05, fontsize=16)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
