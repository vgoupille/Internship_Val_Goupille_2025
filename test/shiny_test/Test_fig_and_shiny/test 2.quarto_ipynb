    {
      "cell_type": "code",
      "metadata": {
        "context": "setup"
      },
      "source": [
        "# Code d'initialisation pour Shiny\n",
        "from shiny import App, render, ui, reactive\n",
        "import matplotlib.pyplot as plt\n",
        "import pandas as pd\n",
        "import seaborn as sns"
      ],
      "id": "e224f727",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "metadata": {
        "component": "shiny"
      },
      "source": [
        "# Définir l'interface utilisateur\n",
        "def ui_components():\n",
        "    return ui.page_fluid(\n",
        "        ui.panel_title(\"Exploration Interactive des Données Pingouins\"),\n",
        "        \n",
        "        ui.layout_sidebar(\n",
        "            ui.panel_sidebar(\n",
        "                ui.input_select(\n",
        "                    \"x_var\",\n",
        "                    \"Variable X:\",\n",
        "                    {\"bill_length_mm\": \"Longueur du bec (mm)\",\n",
        "                     \"bill_depth_mm\": \"Profondeur du bec (mm)\",\n",
        "                     \"flipper_length_mm\": \"Longueur des ailerons (mm)\",\n",
        "                     \"body_mass_g\": \"Masse corporelle (g)\"}\n",
        "                ),\n",
        "                ui.input_select(\n",
        "                    \"y_var\",\n",
        "                    \"Variable Y:\",\n",
        "                    {\"bill_length_mm\": \"Longueur du bec (mm)\",\n",
        "                     \"bill_depth_mm\": \"Profondeur du bec (mm)\",\n",
        "                     \"flipper_length_mm\": \"Longueur des ailerons (mm)\",\n",
        "                     \"body_mass_g\": \"Masse corporelle (g)\"},\n",
        "                    selected=\"bill_depth_mm\"\n",
        "                ),\n",
        "                ui.input_checkbox_group(\n",
        "                    \"species\",\n",
        "                    \"Espèces à afficher:\",\n",
        "                    {\"Adelie\": \"Adelie\", \"Gentoo\": \"Gentoo\", \"Chinstrap\": \"Chinstrap\"},\n",
        "                    selected=[\"Adelie\", \"Gentoo\", \"Chinstrap\"]\n",
        "                ),\n",
        "                ui.input_switch(\"add_regression\", \"Ajouter ligne de régression\", value=False),\n",
        "                ui.hr(),\n",
        "                ui.h4(\"Statistiques\"),\n",
        "                ui.output_text_verbatim(\"stats\")\n",
        "            ),\n",
        "            ui.panel_main(\n",
        "                ui.output_plot(\"scatter_plot\"),\n",
        "                ui.h4(\"Distribution par espèce\"),\n",
        "                ui.output_plot(\"box_plot\")\n",
        "            )\n",
        "        )\n",
        "    )\n",
        "\n",
        "# Définir le serveur\n",
        "def server_components(input, output, session):\n",
        "    \n",
        "    # Fonction pour charger et filtrer les données\n",
        "    @reactive.calc\n",
        "    def filtered_data():\n",
        "        # Utiliser le dataset penguins déjà disponible\n",
        "        from palmerpenguins import load_penguins\n",
        "        df = load_penguins()\n",
        "        \n",
        "        # Filtrer par espèce\n",
        "        df = df[df[\"species\"].isin(input.species())]\n",
        "        \n",
        "        # Nettoyer les données\n",
        "        df = df.dropna(subset=[input.x_var(), input.y_var()])\n",
        "        \n",
        "        return df\n",
        "    \n",
        "    # Fonction pour générer le scatter plot\n",
        "    @output\n",
        "    @render.plot\n",
        "    def scatter_plot():\n",
        "        df = filtered_data()\n",
        "        \n",
        "        plt.figure(figsize=(10, 6))\n",
        "        scatter_plot = sns.scatterplot(\n",
        "            data=df,\n",
        "            x=input.x_var(),\n",
        "            y=input.y_var(),\n",
        "            hue=\"species\",\n",
        "            style=\"sex\",\n",
        "            s=100,\n",
        "            alpha=0.8\n",
        "        )\n",
        "        \n",
        "        # Ajouter une régression si demandé\n",
        "        if input.add_regression():\n",
        "            sns.regplot(\n",
        "                data=df,\n",
        "                x=input.x_var(),\n",
        "                y=input.y_var(),\n",
        "                scatter=False,\n",
        "                color=\"black\",\n",
        "                line_kws={\"linestyle\": \"--\"}\n",
        "            )\n",
        "        \n",
        "        plt.title(f\"Relation entre {input.x_var()} et {input.y_var()}\")\n",
        "        plt.xlabel(dict(filtered_data().dtypes)[input.x_var()])\n",
        "        plt.ylabel(dict(filtered_data().dtypes)[input.y_var()])\n",
        "        \n",
        "        return plt\n",
        "    \n",
        "    # Fonction pour générer le box plot\n",
        "    @output\n",
        "    @render.plot\n",
        "    def box_plot():\n",
        "        df = filtered_data()\n",
        "        \n",
        "        plt.figure(figsize=(10, 6))\n",
        "        sns.boxplot(\n",
        "            data=df,\n",
        "            x=\"species\",\n",
        "            y=input.y_var(),\n",
        "            palette=\"Set2\"\n",
        "        )\n",
        "        plt.title(f\"Distribution de {input.y_var()} par espèce\")\n",
        "        \n",
        "        return plt\n",
        "    \n",
        "    # Fonction pour calculer et afficher les statistiques\n",
        "    @output\n",
        "    @render.text\n",
        "    def stats():\n",
        "        df = filtered_data()\n",
        "        \n",
        "        x_var = input.x_var()\n",
        "        y_var = input.y_var()\n",
        "        \n",
        "        stats_text = f\"Nombre d'observations: {len(df)}\\n\\n\"\n",
        "        \n",
        "        # Statistiques de la variable X\n",
        "        stats_text += f\"Variable X ({x_var}):\\n\"\n",
        "        stats_text += f\"  Min: {df[x_var].min():.2f}\\n\"\n",
        "        stats_text += f\"  Max: {df[x_var].max():.2f}\\n\"\n",
        "        stats_text += f\"  Moyenne: {df[x_var].mean():.2f}\\n\"\n",
        "        stats_text += f\"  Écart-type: {df[x_var].std():.2f}\\n\\n\"\n",
        "        \n",
        "        # Statistiques de la variable Y\n",
        "        stats_text += f\"Variable Y ({y_var}):\\n\"\n",
        "        stats_text += f\"  Min: {df[y_var].min():.2f}\\n\"\n",
        "        stats_text += f\"  Max: {df[y_var].max():.2f}\\n\"\n",
        "        stats_text += f\"  Moyenne: {df[y_var].mean():.2f}\\n\"\n",
        "        stats_text += f\"  Écart-type: {df[y_var].std():.2f}\\n\\n\"\n",
        "        \n",
        "        # Calculer la corrélation\n",
        "        corr = df[[x_var, y_var]].corr().iloc[0, 1]\n",
        "        stats_text += f\"Corrélation: {corr:.4f}\"\n",
        "        \n",
        "        return stats_text\n",
        "\n",
        "# Créer et retourner l'application\n",
        "app = App(ui_components, server_components)\n",
        "app"
      ],
      "id": "368e7bb8",
      "execution_count": null,
      "outputs": []
    }
  ],
