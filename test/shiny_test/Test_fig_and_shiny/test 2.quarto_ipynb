      "source": [
        "# Violin plot of flipper length by species\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "plt.figure(figsize=(10, 6))\n",
        "sns.violinplot(data=penguins, x=\"species\", y=\"flipper_length_mm\", palette=\"Set2\")\n",
        "plt.title(\"Distribution of Flipper Length by Penguin Species\")\n",
        "plt.xlabel(\"Species\")\n",
        "plt.ylabel(\"Flipper Length (mm)\")\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "3aacc5f7",
      "execution_count": null,
      "outputs": []
    },
