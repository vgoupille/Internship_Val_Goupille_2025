      "source": [
        "# Analyse d'expression différentielle - Exemples de visualisations\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from scipy import stats\n",
        "from sklearn.decomposition import PCA\n",
        "import warnings\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# Création de données simulées d'expression différentielle\n",
        "np.random.seed(42)\n",
        "\n",
        "# Nombre de gènes et d'échantillons\n",
        "n_genes = 1000\n",
        "n_samples_per_condition = 5\n",
        "\n",
        "# Créer les noms de gènes et d'échantillons\n",
        "gene_ids = [f\"GENE_{i}\" for i in range(1, n_genes + 1)]\n",
        "sample_ids = [f\"Ctrl_{i}\" for i in range(1, n_samples_per_condition + 1)] + \\\n",
        "             [f\"Treat_{i}\" for i in range(1, n_samples_per_condition + 1)]\n",
        "\n",
        "# Simuler les expressions avec expression différentielle pour certains gènes\n",
        "base_expression = np.exp(np.random.normal(loc=5, scale=2, size=n_genes))\n",
        "expressions = []\n",
        "\n",
        "# Créer une matrice d'expression: lignes=gènes, colonnes=échantillons\n",
        "for i in range(n_genes):\n",
        "    # Expression dans le groupe contrôle\n",
        "    ctrl_expr = np.random.normal(loc=base_expression[i], scale=base_expression[i]*0.2, size=n_samples_per_condition)\n",
        "    \n",
        "    # Déterminer si ce gène a une expression différentielle\n",
        "    is_de = np.random.random() < 0.1  # 10% des gènes sont différentiellement exprimés\n",
        "    fold_change = np.random.uniform(1.5, 3) if is_de else 1.0\n",
        "    direction = np.random.choice([-1, 1]) if is_de else 0\n",
        "    \n",
        "    # Expression dans le groupe traité (avec effet potentiel)\n",
        "    if direction == 1:\n",
        "        treat_expr = np.random.normal(loc=base_expression[i]*fold_change, scale=base_expression[i]*0.2, size=n_samples_per_condition)\n",
        "    else:\n",
        "        treat_expr = np.random.normal(loc=base_expression[i]/fold_change if fold_change > 1 else base_expression[i], \n",
        "                                     scale=base_expression[i]*0.2, size=n_samples_per_condition)\n",
        "    \n",
        "    # Concaténer les expressions des deux groupes\n",
        "    expressions.append(np.concatenate([ctrl_expr, treat_expr]))\n",
        "\n",
        "# Convertir en DataFrame\n",
        "expr_df = pd.DataFrame(expressions, index=gene_ids, columns=sample_ids)\n",
        "\n",
        "# S'assurer qu'il n'y a pas de valeurs négatives dans les données d'expression\n",
        "expr_df = expr_df.clip(lower=0.01)  # Remplacer les valeurs négatives par 0.01\n",
        "\n",
        "# Calculer les moyennes par condition\n",
        "ctrl_mean = expr_df.filter(regex=\"Ctrl\").mean(axis=1)\n",
        "treat_mean = expr_df.filter(regex=\"Treat\").mean(axis=1)\n",
        "\n",
        "# Calculer les statistiques pour chaque gène\n",
        "results = pd.DataFrame(index=gene_ids)\n",
        "results['baseMean'] = (ctrl_mean + treat_mean) / 2\n",
        "results['log2FoldChange'] = np.log2(treat_mean / ctrl_mean)\n",
        "results['pvalue'] = [stats.ttest_ind(\n",
        "    expr_df.iloc[i, :n_samples_per_condition], \n",
        "    expr_df.iloc[i, n_samples_per_condition:]\n",
        ")[1] for i in range(n_genes)]\n",
        "\n",
        "# Correction pour tests multiples (Benjamini-Hochberg)\n",
        "# Implémentation manuelle de la méthode Benjamini-Hochberg\n",
        "def adjust_pvalues_bh(pvalues):\n",
        "    \"\"\"\n",
        "    Correction de Benjamini-Hochberg pour les tests multiples\n",
        "    \"\"\"\n",
        "    n = len(pvalues)\n",
        "    if n <= 0:\n",
        "        return []\n",
        "    \n",
        "    # Convertir en tableau numpy pour faciliter le traitement\n",
        "    pvals_array = np.array(pvalues)\n",
        "    \n",
        "    # Créer les rangs (du plus petit au plus grand)\n",
        "    ranks = np.argsort(pvals_array)\n",
        "    sorted_pvals = pvals_array[ranks]\n",
        "    \n",
        "    # Calculer la p-value ajustée\n",
        "    adjusted_pvals = np.empty_like(sorted_pvals)\n",
        "    \n",
        "    # p-value ajustée pour la plus grande p-value est la même\n",
        "    adjusted_pvals[-1] = sorted_pvals[-1]\n",
        "    \n",
        "    # Commencer par la deuxième plus grande p-value et aller en diminuant\n",
        "    for i in range(n-2, -1, -1):\n",
        "        adjusted_pvals[i] = min(sorted_pvals[i] * n / (i+1), adjusted_pvals[i+1])\n",
        "    \n",
        "    # Remettre dans l'ordre original\n",
        "    original_order = np.argsort(ranks)\n",
        "    return adjusted_pvals[original_order]\n",
        "\n",
        "# Appliquer la correction\n",
        "results['padj'] = adjust_pvalues_bh(results['pvalue'])\n",
        "results['-log10(padj)'] = -np.log10(results['padj'])\n",
        "\n",
        "# Identifier les gènes significativement différentiellement exprimés\n",
        "results['significant'] = (results['padj'] < 0.05) & (abs(results['log2FoldChange']) > 1)\n",
        "\n",
        "# Résumé des résultats\n",
        "print(f\"Total de gènes: {n_genes}\")\n",
        "print(f\"Gènes différentiellement exprimés: {results['significant'].sum()}\")\n",
        "\n",
        "# Création de plusieurs visualisations sur une grille\n",
        "fig = plt.figure(figsize=(14, 12))\n",
        "gs = fig.add_gridspec(2, 2, hspace=0.4, wspace=0.3)\n",
        "\n",
        "# 1. Volcano Plot\n",
        "ax1 = fig.add_subplot(gs[0, 0])\n",
        "volcano = ax1.scatter(\n",
        "    results['log2FoldChange'], \n",
        "    results['-log10(padj)'],\n",
        "    c=results['significant'].map({True: 'red', False: 'grey'}),\n",
        "    alpha=0.6, s=15\n",
        ")\n",
        "ax1.axhline(y=-np.log10(0.05), color='blue', linestyle='--', alpha=0.7)\n",
        "ax1.axvline(x=1, color='blue', linestyle='--', alpha=0.7)\n",
        "ax1.axvline(x=-1, color='blue', linestyle='--', alpha=0.7)\n",
        "ax1.set_title('Volcano Plot')\n",
        "ax1.set_xlabel('log2 Fold Change')\n",
        "ax1.set_ylabel('-log10(Adjusted p-value)')\n",
        "\n",
        "# 2. MA Plot\n",
        "ax2 = fig.add_subplot(gs[0, 1])\n",
        "ma = ax2.scatter(\n",
        "    np.log2(results['baseMean']), \n",
        "    results['log2FoldChange'],\n",
        "    c=results['significant'].map({True: 'red', False: 'grey'}),\n",
        "    alpha=0.6, s=15\n",
        ")\n",
        "ax2.axhline(y=0, color='blue', linestyle='-', alpha=0.7)\n",
        "ax2.set_title('MA Plot')\n",
        "ax2.set_xlabel('log2 Mean Expression')\n",
        "ax2.set_ylabel('log2 Fold Change')\n",
        "\n",
        "# 3. Heatmap des top gènes différentiellement exprimés\n",
        "ax3 = fig.add_subplot(gs[1, 0])\n",
        "# Sélectionner les top gènes différentiellement exprimés\n",
        "top_genes = results[results['significant']].sort_values(by='padj').index[:30]\n",
        "if len(top_genes) == 0:  # Au cas où aucun gène n'est significatif\n",
        "    top_genes = results.sort_values(by='padj').index[:30]\n",
        "\n",
        "# Normaliser les données d'expression pour le heatmap (Z-score)\n",
        "top_expr = expr_df.loc[top_genes]\n",
        "top_expr_z = pd.DataFrame(\n",
        "    stats.zscore(top_expr.values, axis=1),\n",
        "    index=top_expr.index,\n",
        "    columns=top_expr.columns\n",
        ")\n",
        "\n",
        "# Créer l'heatmap\n",
        "sns.heatmap(top_expr_z, cmap='coolwarm', center=0, ax=ax3, cbar_kws={'label': 'Z-score'})\n",
        "ax3.set_title('Heatmap des Top Gènes DE')\n",
        "ax3.set_xlabel('Échantillons')\n",
        "ax3.set_ylabel('Gènes')\n",
        "\n",
        "# 4. PCA Plot\n",
        "ax4 = fig.add_subplot(gs[1, 1])\n",
        "# Préparer les données pour la PCA\n",
        "X = expr_df.T  # Transposer pour avoir les échantillons en lignes et les gènes en colonnes\n",
        "\n",
        "# Log-transformation avec vérification des valeurs problématiques\n",
        "X_log = np.log2(X + 1)  # Ajouter 1 pour éviter log(0)\n",
        "\n",
        "# Vérifier et remplacer les valeurs infinies ou NaN\n",
        "X_log_clean = X_log.copy()\n",
        "X_log_clean = X_log_clean.replace([np.inf, -np.inf], np.nan)\n",
        "X_log_clean = X_log_clean.fillna(X_log_clean.min().min())  # Remplacer NaN par la plus petite valeur\n",
        "\n",
        "# Calculer la PCA\n",
        "pca = PCA(n_components=2)\n",
        "pca_result = pca.fit_transform(X_log_clean)\n",
        "\n",
        "# Créer un DataFrame avec les résultats PCA\n",
        "pca_df = pd.DataFrame(data=pca_result, columns=['PC1', 'PC2'], index=X.index)\n",
        "pca_df['condition'] = pca_df.index.map(lambda x: 'Control' if 'Ctrl' in x else 'Treatment')\n",
        "\n",
        "# Tracer le graphique PCA\n",
        "sns.scatterplot(\n",
        "    data=pca_df, x='PC1', y='PC2', \n",
        "    hue='condition', style='condition', s=100,\n",
        "    palette={'Control': 'blue', 'Treatment': 'red'},\n",
        "    ax=ax4\n",
        ")\n",
        "ax4.set_title('PCA Plot')\n",
        "ax4.set_xlabel(f'PC1 ({pca.explained_variance_ratio_[0]:.1%} variance expliquée)')\n",
        "ax4.set_ylabel(f'PC2 ({pca.explained_variance_ratio_[1]:.1%} variance expliquée)')\n",
        "\n",
        "# Ajouter un titre général\n",
        "fig.suptitle('Analyse d\\'Expression Différentielle', fontsize=16, y=0.98)\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
      "id": "5dc967fe",
      "execution_count": null,
      "outputs": []
    },
