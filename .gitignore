# =============================================================================
# LARGE DATA FILES
# =============================================================================
# Sequencing files and raw data
*.fastq
*.fastq.gz
*.bam # ignore the bam files in the STARsolo output
*.gz

# Raw data
data/raw_data/original_data/*
data/raw_data/unzipped_data/*

# Trimmed data
data/Trim_process/*

# Subsampled data
# Processed and subsampled data (except first_reads/5000_reads)
data/subsampled_data/*
!data/subsampled_data/first_reads/
!data/subsampled_data/first_reads/5000_reads/

# Merged data
data/merged_data/*


# Analyzed data files
*.h5ad
# Exception: allow specific smaller filtered h5ad files
!data/Anndata/filtered/GeneFull_raw_unique_mult_with_metadata_grouped_filtered_100UMI_3b_v2.h5ad
!data/Anndata/filtered/GeneFull_raw_unique_mult_with_metadata_grouped_filtered_100UMI_3c.h5ad
# Exclude large file that exceeds GitHub limits
data/Anndata/filtered/GeneFull_raw_unique_mult_with_metadata_grouped_filtered_100UMI.h5ad

*.rds
*.RDS
# Exception: allow specific smaller RDS files
!data/RDS/GeneFull_raw_unique_mult_with_metadata_grouped_filtered_100UMI_3c_SeuratV5.rds

# =============================================================================
# LOG AND ERROR FILES
# =============================================================================
*.out
*.err
*.log

# =============================================================================
# ENVIRONMENTS AND DEPENDENCIES
# =============================================================================
env/

# =============================================================================
# SYSTEM FILES
# =============================================================================
# macOS system files
.DS_Store
**/.DS_Store

